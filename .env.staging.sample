# Staging deployment environment file
# Copy to .env.staging and adjust values for the staging server

COMPOSE_PROJECT_NAME=umrah-app-staging

# Docker image
APP_IMAGE=ghcr.io/saifibnmazhar/umrah-app
IMAGE_TAG=staging-latest

# Application
APP_NAME=Umrah App Staging
APP_ENV=staging
APP_KEY=
APP_DEBUG=true
APP_URL=https://staging.umrah.binmishaltravels.com
APP_PORT=8001

# Database - MySQL configuration
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=umrah_staging
DB_USERNAME=stageuser
DB_PASSWORD=******

# MySQL root
MYSQL_ROOT_PASSWORD=******

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Laravel Core
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=staging.umrah.binmishaltravels.com
QUEUE_CONNECTION=sync
CACHE_STORE=redis
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Cloudflare trusted proxies
TRUSTED_PROXIES=*

# Docker entrypoint
# Set to false for staging — the CI/CD workflow runs migrations explicitly
MIGRATE=false
