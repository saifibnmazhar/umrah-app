# Staging deployment environment file
# Copy to .env.staging and adjust values for the staging server

# Set COMPOSE_PROJECT_NAME for project isolation
# (docker-compose.staging.yml defaults to umrah-app-staging — keep it)
# Staging lives at /var/www/staging-umrah.binmishaltravels.com/web

# Docker image
APP_IMAGE=ghcr.io/saifibnmazhar/umrah-app
IMAGE_TAG=staging

# Application
APP_NAME="Umrah App Staging"
APP_ENV=staging
APP_KEY=
APP_DEBUG=true
APP_URL=https://staging.umrah.binmishaltravels.com
APP_PORT=8001

# Database - MySQL configuration
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=umrah_staging
DB_USERNAME=stageuser
DB_PASSWORD=******

# Database type: mysql or postgresql — DEVELOPMENT ONLY.
# The dev docker-compose.yml selects the engine with `--profile ${DB_TYPE}`.
# docker-compose.staging.yml has no profiles and is MySQL-only.
DB_TYPE=mysql

# MySQL root
MYSQL_ROOT_PASSWORD=******

# Redis
# REDIS_PASSWORD must match between the app and the compose redis service:
# both read this file. Staging runs redis without a password (it is not
# published outside the compose network) - keep this empty to match the
# live staging server. Production sets a real one in .env.production.
REDIS_IMAGE=redis:7-alpine
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_CLUSTER=redis
REDIS_PERSISTENT=false
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default

# Laravel Core
# Sessions run on redis. With SESSION_CONNECTION unset they live in the redis
# "default" database (REDIS_DB), NOT in REDIS_CACHE_DB — so `cache:clear` cannot
# log users out. Use `php artisan sessions:flush` for that.
# The "database" driver needs a sessions table migration, which this app does not have.
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=staging.umrah.binmishaltravels.com
QUEUE_CONNECTION=sync
CACHE_STORE=redis
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Cloudflare trusted proxies
TRUSTED_PROXIES=*

# Docker entrypoint
# Set to false for staging — the CI/CD workflow runs migrations explicitly
MIGRATE=false
