# Production deployment environment file
# Used by docker-compose.prod.yml via env_file directive

# Application
APP_NAME=Umrah App
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
APP_PORT=8000

# Database
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=umrah_app_prod
DB_USERNAME=techcandle_umrah
DB_PASSWORD=***

# Postgres container vars (consumed by the postgres:16-alpine image on FIRST init of an
# empty volume only; must mirror DB_DATABASE / DB_USERNAME / DB_PASSWORD above)
POSTGRES_DB=umrah_app_prod
POSTGRES_USER=techcandle_umrah
POSTGRES_PASSWORD=***

# Laravel Core
SESSION_DRIVER=database
QUEUE_CONNECTION=sync
CACHE_STORE=redis
LOG_CHANNEL=stack
LOG_LEVEL=info

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=***
REDIS_PORT=6379
REDIS_CLUSTER=redis
REDIS_PERSISTENT=false
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default

# Security
APP_KEY=base64:GENERATE_THIS_ON_DEPLOY

# Mail
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=""
MAIL_PASSWORD=******
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="Umrah App"

# Watchtower / migrations
MIGRATE=true
