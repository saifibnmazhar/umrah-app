# Production deployment environment file
# Used by docker-compose.prod.yml via env_file directive
# ============================================================
# Docker
# ============================================================

COMPOSE_PROJECT_NAME=umrah-binmishaltravels-com

APP_IMAGE=ghcr.io/saifibnmazhar/umrah-app
IMAGE_TAG=latest

# Application
APP_NAME=Umrah App
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://umrah.binmishaltravels.com
APP_PORT=8002

# Database - MySQL configuration
DB_IMAGE=mysql:8.0
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_EXPOSE_PORT=3306
DB_DATABASE=binmishal_umrah_live
DB_USERNAME=binmishal_umrah
DB_PASSWORD=*******

MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=binmishal_umrah_live
MYSQL_USER=binmishal_umrah
MYSQL_PASSWORD=*******
MYSQL_ROOT_PASSWORD=*****

# Laravel Core
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=sync
CACHE_STORE=redis
LOG_CHANNEL=stack
LOG_LEVEL=info

# Redis
REDIS_IMAGE=redis:7-alpine
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=***
REDIS_PORT=6379
REDIS_CLUSTER=redis
REDIS_PERSISTENT=false
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default


# Mail
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=""
MAIL_PASSWORD=******
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="Umrah App"

# Watchtower / migrations
MIGRATE=false
